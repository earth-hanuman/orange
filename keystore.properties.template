# Copy this file to `keystore.properties` (which is gitignored) and fill in your
# real values. These are secrets — never commit keystore.properties or the .jks.
#
# Generate a keystore once:
#   keytool -genkey -v -keystore orange-release.jks -alias orange \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Then `./gradlew :app:assembleRelease` produces a signed
# app/build/outputs/apk/release/app-release.apk

storeFile=orange-release.jks
storePassword=CHANGEME
keyAlias=orange
keyPassword=CHANGEME
